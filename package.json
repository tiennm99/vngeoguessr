    "eslint": "^9.39.4",
    "eslint-config-next": "15.4.6",
    "globals": "^17.11.0",
    "pbf": "^5.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "postcss": "^8.5.10"
